# Show PHP and JavaScript in GitHub language statistics
*.php linguist-detectable=true
*.js  linguist-detectable=true

# Exclude frontend markup/styles if you don't want them counted
*.css  linguist-detectable=false
*.scss linguist-detectable=false
*.sass linguist-detectable=false
*.html linguist-detectable=false
*.htm  linguist-detectable=false

# Exclude generated files
*.map linguist-generated=true
*.min.js linguist-vendored=true
*.min.css linguist-vendored=true